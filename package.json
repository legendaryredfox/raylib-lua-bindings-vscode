{
  "name": "raylib-lua-bindings-autocomplete",
  "displayName": "Autocomplete for raylib-lua-bindings",
  "description": "Autocomplete for raylib-lua-bindings",
  "publisher": "LegendaryRedfox",
  "repository": "https://github.com/legendaryredfox/raylib-lua-bindings-vscode",
  "version": "0.10.0",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:lua"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Raylib Lua Bindings",
      "properties": {
        "raylib-lua.namespace": {
          "type": "string",
          "default": "raylib",
          "description": "Namespace prefix used to trigger autocomplete (e.g. 'raylib' or 'rl')."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1"
  }
}
